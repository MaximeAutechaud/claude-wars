[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/title.gd" id="1_title"]

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_title")

[node name="Background" type="ColorRect" parent="."]
show_behind_parent = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.07, 0.08, 0.1, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Box" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 64
theme_override_colors/font_color = Color(0.92, 0.94, 1, 1)
theme_override_colors/font_shadow_color = Color(0.25, 0.55, 1, 0.35)
theme_override_constants/shadow_offset_x = 0
theme_override_constants/shadow_offset_y = 3
text = "CLAUDE WARS"
horizontal_alignment = 1

[node name="SubLabel" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(1, 0.82, 0.15, 1)
text = "Acte I — La Marche du Bord"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Center/Box"]
layout_mode = 2
custom_minimum_size = Vector2(0, 30)

[node name="ContinueButton" type="Button" parent="Center/Box"]
layout_mode = 2
custom_minimum_size = Vector2(280, 44)
theme_override_font_sizes/font_size = 18
text = "Continuer"

[node name="NewGameButton" type="Button" parent="Center/Box"]
layout_mode = 2
custom_minimum_size = Vector2(280, 44)
theme_override_font_sizes/font_size = 18
text = "Nouvelle partie"

[node name="QuitButton" type="Button" parent="Center/Box"]
layout_mode = 2
custom_minimum_size = Vector2(280, 44)
theme_override_font_sizes/font_size = 18
text = "Quitter"

[connection signal="pressed" from="Center/Box/ContinueButton" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="Center/Box/NewGameButton" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="Center/Box/QuitButton" to="." method="_on_quit_pressed"]
